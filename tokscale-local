#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BIN_PATH="$ROOT_DIR/target/release/tokscale"

needs_build=0
if [[ ! -x "$BIN_PATH" ]]; then
  needs_build=1
else
  while IFS= read -r path; do
    if [[ "$path" -nt "$BIN_PATH" ]]; then
      needs_build=1
      break
    fi
  done < <(
    find \
      "$ROOT_DIR/Cargo.toml" \
      "$ROOT_DIR/Cargo.lock" \
      "$ROOT_DIR/crates" \
      "$ROOT_DIR/packages" \
      "$ROOT_DIR/scripts" \
      -type f
  )
fi

if [[ "$needs_build" -eq 1 ]]; then
  cargo build -q -p tokscale-cli --release --manifest-path "$ROOT_DIR/Cargo.toml"
fi

exec "$BIN_PATH" "$@"
